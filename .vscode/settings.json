{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex-direct",
      "command": "C:/Users/htaus/AppData/Local/Programs/MiKTeX/miktex/bin/x64/pdflatex.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "paper-full-build",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%WORKSPACE_FOLDER%/scripts/build_paper.ps1"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex direct",
      "tools": [
        "pdflatex-direct"
      ]
    },
    {
      "name": "paper full build",
      "tools": [
        "paper-full-build"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "paper full build"
}
